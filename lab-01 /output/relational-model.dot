digraph D {
 graph [rankdir=LR, bgcolor="#ffffff", nodesep="1.0", ranksep="1.1", pad="0.4", splines=polyline, fontname="Helvetica"];
 node [shape=plain, fontname="Helvetica"];
 students [label=<
   <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#BED0E0" BGCOLOR="white">
      <TR><TD BGCOLOR="#143B5B" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="19"><B>students</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#163958" POINT-SIZE="15"><B>PK</B>  student_id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">student_name</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">program</FONT></TD></TR>
    </TABLE>>];
 equipment [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#BED0E0" BGCOLOR="white">
      <TR><TD BGCOLOR="#143B5B" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="19"><B>equipment</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#163958" POINT-SIZE="15"><B>PK</B>  equipment_id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">item_name</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">category</FONT></TD></TR>
    </TABLE>>];
 loans [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" COLOR="#9BD1DC" BGCOLOR="white">
      <TR><TD BGCOLOR="#087F8C" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="19"><B>loans</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#163958" POINT-SIZE="15"><B>PK</B>  loan_id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="15"><B>FK</B>  student_id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="15"><B>FK</B>  equipment_id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">borrowed_on</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">due_on</FONT></TD></TR>
    </TABLE>>];
 {rank=same; students; equipment;}
 students -> loans [color="#087F8C", penwidth=2, fontsize=14, fontcolor="#163958", label="1 to many", arrowhead=vee];
 equipment -> loans [color="#087F8C", penwidth=2, fontsize=14, fontcolor="#163958", label="1 to many", arrowhead=vee];
}
