digraph festival_model {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.55", ranksep="1.3", label="Community Film Festival — Relational Model", labelloc="t", fontsize=22, fontname="DejaVu Sans", fontcolor="#102C45", splines=polyline];
  node [shape=record, style="rounded,filled", fillcolor="#F0F5FA", color="#71879E", fontname="DejaVu Sans", fontsize=12];
  edge [color="#50718F", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10];
  filmmakers [label="{filmmakers|filmmaker_id (PK)\lfirst_name, last_name\lemail (UNIQUE)\lbirth_date, hometown\l}"];
  filmmaker_phones [label="{filmmaker_phones|filmmaker_id (PK, FK)\lphone_number (PK)\lphone_type\l}"];
  film_categories [label="{film_categories|category_id (PK)\lcategory_name (UNIQUE)\l}"];
  films [label="{films|film_id (PK)\lfilm_code (UNIQUE)\lcategory_id (FK)\ltitle, release_year\lduration_minutes\l}"];
  film_creators [label="{film_creators|film_id (PK, FK)\lfilmmaker_id (PK, FK)\lcontribution_role\l}"];
  venues [label="{venues|venue_id (PK)\lvenue_name\lstreet, city, postal_code\lcapacity\l}"];
  screenings [label="{screenings|screening_id (PK)\lfilm_id (FK)\lvenue_id (FK)\lstarts_at, ticket_price\lscreening_status\l}"];
  filmmakers -> filmmaker_phones [label="1 : many"];
  filmmakers -> film_creators [label="1 : many"];
  film_categories -> films [label="1 : many"];
  films -> film_creators [label="1 : many"];
  films -> screenings [label="1 : many"];
  venues -> screenings [label="1 : many"];
}
